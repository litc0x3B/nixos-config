{
  "agent_servers": {
    "antigravity-acp": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "right",
  },
  "cli_default_open_behavior": "existing_window",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Noctalia Light",
    "dark": "Tokyo Night Storm",
  },
  "auto_install_extensions": {
    "nix": true,
    "kdl": true,
    "git-firefly": true,
    "toml": true,
    "tokyo-night": true,
    "yaml": true,
  },
}
